generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TagColor {
  gray
  red
  orange
  yellow
  green
  blue
  purple
  pink
}

enum ViewMatchMode {
  ALL
  ANY
}

enum ItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

model View {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  order     Int
  orderKey  String?
  userId    String        @db.Uuid
  type      ViewType      @default(CUSTOM)
  isDefault Boolean       @default(false)
  matchMode ViewMatchMode @default(ALL)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  viewLists ViewList[]
  viewTags  ViewTag[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, order])
  @@index([userId, orderKey])
  @@index([userId, type])
}

model ViewList {
  viewId  String  @db.Uuid
  listId  String  @db.Uuid
  order   Int
  orderKey String?

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([viewId, listId])
  @@index([viewId, order])
  @@index([viewId, orderKey])
  @@index([listId])
}

model List {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  userId      String   @db.Uuid
  workspaceId String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listItems  ListItem[]
  listTags   ListTag[]
  viewLists  ViewList[]
  listShares ListShare[]
  shareLinks ShareLink[]
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
}

model ListItem {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  completed     Boolean    @default(false)
  status        ItemStatus @default(TODO)
  assigneeId    String?    @db.Uuid
  order         Int
  orderKey      String?
  boardOrderKey String?
  notes         String?
  listId        String     @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  parentList List @relation(fields: [listId], references: [id], onDelete: Cascade)
  noteDoc    ItemNoteDoc?

  @@index([listId])
  @@index([listId, order])
  @@index([listId, orderKey])
  @@index([assigneeId])
  @@index([boardOrderKey])
}

model ItemNoteDoc {
  itemId    String   @id @db.Uuid
  state     Bytes
  updatedAt DateTime @updatedAt

  item ListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  color     TagColor @default(gray)
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listTags ListTag[]
  viewTags ViewTag[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, name])
}

model ListTag {
  listId String @db.Uuid
  tagId  String @db.Uuid

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([listId, tagId])
  @@index([tagId])
}

model ViewTag {
  viewId String @db.Uuid
  tagId  String @db.Uuid

  view View @relation(fields: [viewId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([viewId, tagId])
  @@index([tagId])
}

model ReplicacheClientGroup {
  id        String   @id
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  clients           ReplicacheClient[]
  clientViewRecords ReplicacheClientViewRecord[]

  @@index([userId])
}

model ReplicacheClient {
  id             String @id
  clientGroupId  String
  lastMutationID Int    @default(0)

  clientGroup ReplicacheClientGroup @relation(fields: [clientGroupId], references: [id], onDelete: Cascade)

  @@index([clientGroupId])
}

model ReplicacheClientViewRecord {
  id            String   @id
  clientGroupId String
  entities      Json
  createdAt     DateTime @default(now())

  clientGroup ReplicacheClientGroup @relation(fields: [clientGroupId], references: [id], onDelete: Cascade)

  @@index([clientGroupId, createdAt])
}

enum ViewType {
  ALL_LISTS
  UNTAGGED
  CUSTOM
}

enum ShareRole {
  OWNER
  EDITOR
  VIEWER
}

enum ShareResourceType {
  LIST
  WORKSPACE
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderKey String?

  lists      List[]
  members    WorkspaceMember[]
  shareLinks ShareLink[]

  @@index([ownerId])
  @@index([ownerId, orderKey])
}

model WorkspaceMember {
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  role        ShareRole
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model ListShare {
  listId    String    @db.Uuid
  userId    String    @db.Uuid
  role      ShareRole
  createdAt DateTime  @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId])
}

model ShareLink {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token        String            @unique
  resourceType ShareResourceType
  role         ShareRole
  listId       String?           @db.Uuid
  workspaceId  String?           @db.Uuid
  createdById  String            @db.Uuid
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())

  list      List?      @relation(fields: [listId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([workspaceId])
  @@index([createdById])
}
