# ---------------------------------------------------------------------------
# Application (required to run the app)
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Read at runtime by the Prisma client (lib/db.ts).
# Use a pooled connection string in production. The Prisma datasource has no
# inline url; the client reads this variable directly.
DATABASE_URL=postgresql://user:password@localhost:5432/tidy

# Supabase project URL and publishable (anon) key. Used by the browser and
# server Supabase clients (auth) and by the realtime poke path.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Canonical absolute site URL, no trailing slash. Used for metadata and share
# links (app/layout.tsx, lib/utils.ts). Optional locally; absoluteUrl falls
# back to VERCEL_URL, then http://localhost:$PORT. Set this in production.
# NEXT_PUBLIC_SITE_URL=https://tidy.example.com

# Opt-in offline app-shell service worker (lib/sw/register-service-worker.ts).
# Leave unset/false unless testing the service worker locally.
NEXT_PUBLIC_OFFLINE_APP_SHELL_ENABLED=false

# ---------------------------------------------------------------------------
# Test (Playwright E2E)
# ---------------------------------------------------------------------------
# Each parallel Playwright worker authenticates as a distinct user: worker N uses the (N+1)th pool entry.
# Provide at least as many users as --workers (default 2). Worker 0 falls back to the legacy single
# E2E_TEST_EMAIL/E2E_TEST_PASSWORD if no numbered pool is set (serial runs only).
E2E_TEST_EMAIL_1=your-test-user-1@example.com
E2E_TEST_PASSWORD_1=your-test-password-1
E2E_TEST_EMAIL_2=your-test-user-2@example.com
E2E_TEST_PASSWORD_2=your-test-password-2

# Legacy single-user fallback (worker 0 only; run with --workers=1):
# E2E_TEST_EMAIL=your-test-user@example.com
# E2E_TEST_PASSWORD=your-test-password

# Collaborative item notes are opt-in until the Yjs path is proven.
NEXT_PUBLIC_YJS_NOTES_ENABLED=false

# Server-only Supabase service-role key. Required for the server to SEND realtime
# pokes (the /api/replicache/push doorbell that makes shared renames propagate fast).
# realtime.messages has RLS enabled (2.0.6); the anon key cannot INSERT broadcasts,
# so the server uses the service-role key, which bypasses RLS. NEVER expose this to
# the client (no NEXT_PUBLIC_ prefix). Without it, pokes no-op and clients heal via
# the 60s Replicache pull.
SUPABASE_SERVICE_ROLE_KEY=
